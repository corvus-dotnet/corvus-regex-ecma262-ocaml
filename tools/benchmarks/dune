; The Industry harness (run.sh), built only in the harness profile (dune build --profile harness, as
; tools/benchmarks/build.sh and the image build it), where re and pcre2 are installed: the package and its tests need
; neither. A profile other than dev takes dune's release settings.

(executable
 (name industry)
 (enabled_if
  (= %{profile} harness))
 (libraries corvus-regex-ecma262 re pcre2 unix))

(rule
 (targets build_info.ml)
 (action
  (with-stdout-to
   build_info.ml
   (echo "let flambda = %{ocaml-config:flambda}\n"))))
