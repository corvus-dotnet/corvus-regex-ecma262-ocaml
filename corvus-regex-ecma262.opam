# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.2"
synopsis:
  "ECMA-262 (JavaScript) regular expressions: the grammar and the answers of RegExp, over UTF-8 and UTF-16"
description:
  "Regular expressions with the grammar and the answers of ECMA-262, the RegExp of JavaScript: every flag, lookbehind, named groups, modifier groups, Unicode property escapes and the v flag's set notation, matched over UTF-8 or UTF-16 text with no copy, in time proportional to the pattern times the text for a pattern without backreferences. A port of the corvus-regex-ecma262 Rust crate."
maintainer: ["Endjin Limited <hello@endjin.com>"]
authors: ["Endjin Limited"]
license: "Apache-2.0"
homepage: "https://github.com/corvus-dotnet/corvus-regex-ecma262-ocaml"
bug-reports:
  "https://github.com/corvus-dotnet/corvus-regex-ecma262-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "odoc" {with-doc}
]
dev-repo:
  "git+https://github.com/corvus-dotnet/corvus-regex-ecma262-ocaml.git"
# The package assumes the 63-bit int of a 64-bit OCaml.
available: arch != "arm32" & arch != "x86_32" & arch != "ppc32"
# dune's own build field, without "dune subst" for a pinned package. The version is written in dune-project, and
# subst would replace it with the name of the tag (v<version>), which is not the version of the package.
build: [
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
